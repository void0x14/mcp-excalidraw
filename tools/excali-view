#!/usr/bin/env python3
"""excali-view — Excalidraw MCP App widget'ini tarayicida acar ve diyagrami gosterir.

Kullanim:
  excali-view <dosya.excalidraw>   # viewer'i baslat (veya guncelle) + diyagrami goster
  excali-view --stop               # viewer'i durdur

Neden gerekli: grok CLI ve opencode TUI, MCP App widget HTML'ini render etmez
(mcpApps=false) ve terminal grafik protokollerini yutar. Widget'in kendisi
tarayicida sorunsuz cizilir; bu betik onu oraya tasir.

Host gorevi: widget bir MCP App'tir ve pan/zoom/duzenleme/export icin HOST'a
JSON-RPC gonderir. Bu betik o host'u gercekten uygular:
  - ui/open-link              -> xdg-open ile URL acar
  - ui/request-display-mode   -> {mode} doner, iframe'i tam ekrana alir
  - tools/call                -> gercek MCP server'a (stdio) iletilir
                                 (export_to_excalidraw, read_checkpoint, save_checkpoint)
Onceki surum bu metotlara bos {} / sabit "ok" donuyordu; bu yuzden
"Open in Excalidraw" ve "Edit" calismiyordu.

Viewer tek surectir ve sahneyi her istekte diskten okur; bu yuzden ajan yeni bir
diyagram urettiginde pencere kendiliginden guncellenir (sayfa /scene'i yoklar).
"""
import hashlib
import http.server
import json
import os
import socket
import socketserver
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser("~")
# Repo root: this script lives in <repo>/tools/. Allow an override so a copy
# installed elsewhere (~/.local/bin/excali-view) can point at the real checkout.
REPO = os.environ.get("EXCALIDRAW_MCP_REPO") or os.path.dirname(
    os.path.dirname(os.path.abspath(__file__))
)
WIDGET = os.path.join(REPO, "dist/mcp-app.html")
SERVER = os.path.join(REPO, "dist/index.js")
SCENE = os.environ.get("EXCALI_SCENE") or "/tmp/excalidraw-latest.excalidraw"
PORT = int(os.environ.get("EXCALI_PORT") or 8765)
VIEWDIR = os.environ.get("EXCALI_VIEW_DIR") or "/tmp/excali-view"
PIDFILE = os.path.join(VIEWDIR, "viewer.pid")
PORTFILE = os.path.join(VIEWDIR, "port")
OPENLOG = os.path.join(VIEWDIR, "opened-urls.log")
MCPLOG = os.path.join(VIEWDIR, "mcp-stderr.log")


def ensure_dir():
    os.makedirs(VIEWDIR, exist_ok=True)


def find_port(start=PORT):
    for p in range(start, start + 50):
        with socket.socket() as s:
            if s.connect_ex(("127.0.0.1", p)) != 0:
                return p
    raise SystemExit("bos port bulunamadi")


# ============================================================
# MCP stdio client — widget'in tools/call isteklerini gercek sunucuya iletir
# ============================================================
class McpClient:
    def __init__(self):
        node = None
        for c in ("node", "/usr/bin/node", "/usr/local/bin/node"):
            if os.path.sep in c:
                if os.path.exists(c):
                    node = c
                    break
            else:
                from shutil import which
                node = which(c)
                if node:
                    break
        if not node:
            raise RuntimeError("node bulunamadi")
        ensure_dir()
        self._log = open(MCPLOG, "ab")
        self.proc = subprocess.Popen(
            [node, SERVER, "--stdio"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=self._log,
            text=True, bufsize=1, cwd=REPO,
        )
        self.lock = threading.Lock()
        self.pending = {}
        self._id = 0
        threading.Thread(target=self._reader, daemon=True).start()
        self._request("initialize", {
            "protocolVersion": "2024-11-05",
            "capabilities": {},
            "clientInfo": {"name": "excali-view", "version": "1.1.0"},
        })
        self._notify("notifications/initialized", {})

    def _reader(self):
        try:
            for line in self.proc.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                mid = msg.get("id")
                if mid is not None and mid in self.pending:
                    self.pending[mid].append(msg)
        except Exception:
            pass

    def _write(self, obj):
        self.proc.stdin.write(json.dumps(obj) + "\n")
        self.proc.stdin.flush()

    def _request(self, method, params, timeout=90):
        with self.lock:
            self._id += 1
            mid = self._id
            q = []
            self.pending[mid] = q
            self._write({"jsonrpc": "2.0", "id": mid, "method": method, "params": params})
            deadline = time.time() + timeout
            while not q and time.time() < deadline and self.proc.poll() is None:
                time.sleep(0.01)
            self.pending.pop(mid, None)
            if not q:
                raise TimeoutError(f"{method} zaman asimi")
            return q[0]

    def _notify(self, method, params):
        with self.lock:
            self._write({"jsonrpc": "2.0", "method": method, "params": params})

    def call_tool(self, name, arguments):
        resp = self._request("tools/call", {"name": name, "arguments": arguments or {}})
        if "error" in resp:
            return {"content": [{"type": "text", "text": str(resp["error"].get("message", resp["error"]))}],
                    "isError": True}
        return resp.get("result", {})


_mcp_lock = threading.Lock()
_mcp = None


def _reset_mcp():
    global _mcp
    with _mcp_lock:
        if _mcp is not None:
            try:
                _mcp.proc.kill()
            except Exception:
                pass
        _mcp = None


def call_mcp(name, arguments):
    """Forward a tools/call to the stdio MCP server; respawn once on failure."""
    global _mcp
    last = None
    for attempt in (0, 1):
        try:
            with _mcp_lock:
                if _mcp is None:
                    _mcp = McpClient()
                client = _mcp
            return client.call_tool(name, arguments)
        except Exception as e:
            last = e
            _reset_mcp()
            if attempt == 0:
                time.sleep(0.3)
    return {"content": [{"type": "text", "text": f"mcp-call failed: {last}"}], "isError": True}


